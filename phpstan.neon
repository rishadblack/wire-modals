includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - src
        - config
        - tests/Fixtures
    tmpDir: build/phpstan
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Package views live outside resource_path(), so Larastan cannot see them.
        - message: '#expects view-string#'
